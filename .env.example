# CloudMarket IaaS — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# Database
POSTGRES_USER=cloudmarket
POSTGRES_PASSWORD=cloudmarket_secret
POSTGRES_DB=cloudmarket
DATABASE_URL=postgresql://cloudmarket:cloudmarket_secret@db:5432/cloudmarket?schema=public

# API
PORT=3001

# MCP — Remote Model Context Protocol endpoint (served by the existing api
# container on the already-published port 3001: POST /mcp).
# MCP_API_KEY is REQUIRED to activate /mcp: clients must send
#   Authorization: Bearer <MCP_API_KEY>
# It FAILS CLOSED: when MCP_API_KEY is unset or empty, every /mcp request is
# rejected with 401 and the endpoint stays disabled. Generate a strong secret,
# e.g. `openssl rand -hex 32`.
MCP_API_KEY=

# Legacy SSE fallback transport for old MCP clients (GET /sse + POST /messages,
# same bearer auth). Disabled by default — set to 1 only if a client cannot
# use the Streamable HTTP transport on POST /mcp.
MCP_ENABLE_SSE=0

# Admin API key — enforced by /api/admin via the x-admin-api-key header and
# required by the MCP admin tools (the client must send the same key in the
# x-admin-api-key header). Leave empty to keep /api/admin open.
ADMIN_API_KEY=

# Web / Frontend
VITE_API_URL=http://localhost:3001

# Prisma — Target platform for engine generation
# Uncomment the one matching your container base image:
PRISMA_CLI_BINARY_TARGETS=linux-arm64-openssl-3.0.x
##PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x
##PRISMA_CLI_BINARY_TARGETS=darwin

# Docker base images (optional — use your corporate registry mirror)
# REPO_URL=registry.company.com
# API_IMAGE=node
# API_TAG=20-bookworm
# WEB_IMAGE=node
# WEB_TAG=20-alpine

# Docker Compose proxy settings (optional)
# COMPOSE_HTTP_PROXY=
# COMPOSE_HTTPS_PROXY=
# COMPOSE_NO_PROXY=
# COMPOSE_NODE_TLS_REJECT_UNAUTHORIZED=1
