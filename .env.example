# CloudMarket IaaS — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# Database
POSTGRES_USER=cloudmarket
POSTGRES_PASSWORD=cloudmarket_secret
POSTGRES_DB=cloudmarket
DATABASE_URL=postgresql://cloudmarket:cloudmarket_secret@db:5432/cloudmarket?schema=public

# API
PORT=3001

# Web / Frontend
VITE_API_URL=http://localhost:3001

# Prisma — Air-gapped / offline environment
# Pre-generate engine binaries and copy them to lib/prisma/
# See README.md "Prisma in Air-Gapped Environments" for details.
export PRISMA_GENERATE_SKIP_AUTOINSTALL=1
export PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
export PRISMA_QUERY_ENGINE_LIBRARY="./lib/prisma/libquery_engine-linux-arm64-openssl-3.0.x.so.node"
export PRISMA_QUERY_ENGINE_BINARY="./lib/prisma/libquery_engine-linux-arm64-openssl-3.0.x.so.node"
export PRISMA_SCHEMA_ENGINE_BINARY="./lib/prisma/schema-engine-debian-openssl-3.0.x"
export PRISMA_MIGRATION_ENGINE_BINARY="./lib/prisma/schema-engine-debian-openssl-3.0.x"

# Docker Compose proxy settings (optional)
# COMPOSE_HTTP_PROXY=
# COMPOSE_HTTPS_PROXY=
# COMPOSE_NO_PROXY=
# COMPOSE_NODE_TLS_REJECT_UNAUTHORIZED=1
