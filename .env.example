# CloudMarket IaaS — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# Database
POSTGRES_USER=cloudmarket
POSTGRES_PASSWORD=cloudmarket_secret
POSTGRES_DB=cloudmarket
DATABASE_URL=postgresql://cloudmarket:cloudmarket_secret@db:5432/cloudmarket?schema=public

# API
PORT=3001

# Web / Frontend
VITE_API_URL=http://localhost:3001

# Prisma — Target platform for engine generation
# Uncomment the one matching your container base image:
PRISMA_CLI_BINARY_TARGETS=linux-arm64-openssl-3.0.x
##PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x
##PRISMA_CLI_BINARY_TARGETS=darwin

# Docker Compose proxy settings (optional)
# COMPOSE_HTTP_PROXY=
# COMPOSE_HTTPS_PROXY=
# COMPOSE_NO_PROXY=
# COMPOSE_NODE_TLS_REJECT_UNAUTHORIZED=1
