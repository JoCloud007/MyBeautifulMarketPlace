# Build dependencies are installed inside the container, but we keep
# node_modules/.prisma/ and node_modules/@prisma/client/ from the host
# because they contain the generated Prisma client with the Linux binary.

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test files
**/coverage
**/*.test.ts
**/*.test.tsx
**/__tests__

# Build outputs (built on host for air-gap, copied into containers)
# NOTE: we used to exclude these when building inside containers.
# Now builds run on the host, so dist/ must be in the build context.
# apps/*/dist
# packages/*/dist
# apps/*/build
# packages/*/build

# Logs
*.log
npm-debug.log*

# Temporary files
tmp
temp
*.tmp

# Docker files themselves (not needed in context)
docker-compose.yml
Dockerfile
.dockerignore

# Documentation (not needed for build)
*.md

# Tidet files
.tidet
