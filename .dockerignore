# Build dependencies are installed inside the container, but we keep
# node_modules/.prisma/ and node_modules/@prisma/client/ from the host
# because they contain the generated Prisma client with the Linux binary.

# node_modules — installed inside container, not copied from host
node_modules
apps/*/node_modules
packages/*/node_modules

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test files
**/coverage
**/*.test.ts
**/*.test.tsx
**/__tests__

# Build outputs (will be rebuilt inside container)
# WARNING: do not use **/dist — it would exclude node_modules/*/dist/
apps/*/dist
packages/*/dist
apps/*/build
packages/*/build

# Logs
*.log
npm-debug.log*

# Temporary files
tmp
temp
*.tmp

# Docker files themselves (not needed in context)
docker-compose.yml
Dockerfile
.dockerignore

# Documentation (not needed for build)
*.md

# Tidet files
.tidet
