
# Dependencies
node_modules/

# OS
.DS_Store

# npm config (may contain registry auth tokens)
.npmrc

# Environment variables (secrets)
.env
.env.local

# Tidet
.tidet/

# Docker Compose local overrides (machine-specific)
docker-compose.override.yml

# Build outputs
apps/api/dist/
apps/web/dist/

# Local secrets (mount via docker-compose.override.yml)
.secrets/

# Build outputs
packages/shared-types/dist/
deploy.log

# Local DB backups (data — never commit)
backup_*.sql

# Environment backups (carry secrets — never commit)
.env.bak
.env.bak-*

# Machine-local Prisma dev engine (regenerated by make build;
# container binaries in lib/prisma/ stay tracked)
lib/prisma/libquery_engine-darwin-arm64*
