
# Dependencies
node_modules/

# OS
.DS_Store

# npm config (may contain registry auth tokens)
.npmrc

# Environment variables (secrets)
.env
.env.local

# Tidet per-session git worktrees (P2a)
.tidet/worktrees/

# Docker Compose local overrides (machine-specific)
docker-compose.override.yml

# Local secrets (mount via docker-compose.override.yml)
.secrets/

# Tidet session files
.tidet/.gitignore
.tidet/memory/

# Build outputs
packages/shared-types/dist/
