generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  description       String?
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id])
  computeType       ComputeType?
  variants          ProductVariant[]
  dependencies      Dependency[]   @relation("ProductDependencies")
  dependentProducts Dependency[]   @relation("ProductDependents")
  forecastLines     ForecastLine[]
  upgradeFrom       UpgradePath[]  @relation("UpgradeFrom")
  upgradeTo         UpgradePath[]  @relation("UpgradeTo")
  instances         Instance[]
  documentation     String?
  roadmap           String?
  os                String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model OperatingSystem {
  id        String          @id @default(uuid())
  family    String
  name      String
  slug      String          @unique
  isActive  Boolean         @default(true)
  versions  OsVersion[]
  variants  ProductVariant[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model OsVersion {
  id                 String          @id @default(uuid())
  osId               String
  os                 OperatingSystem @relation(fields: [osId], references: [id], onDelete: Cascade)
  version            String
  releaseDate        DateTime
  normalSupportEnd   DateTime
  extendedSupportEnd DateTime
  eolDate            DateTime
  phase              LifecyclePhase  @default(RELEASED)
  isActive           Boolean         @default(true)
  variants           ProductVariant[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([osId, version])
}

model ProductVariant {
  id                String                           @id @default(uuid())
  productId         String
  product           Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  osId              String
  os                OperatingSystem                  @relation(fields: [osId], references: [id])
  osVersionId       String
  osVersion         OsVersion                        @relation(fields: [osVersionId], references: [id])
  flavorId          String
  flavor            Flavor                           @relation(fields: [flavorId], references: [id])
  availabilityZones ProductVariantAvailabilityZone[]
  continuityLevelId String?
  continuityLevel   ContinuityLevel?                 @relation(fields: [continuityLevelId], references: [id])
  instances         Instance[]
  forecastLines     ForecastLine[]
  isActive          Boolean                          @default(true)
  availabilityType  AvailabilityType                 @default(STANDARD)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  @@unique([productId, name])
}

model ProductVariantAvailabilityZone {
  variantId          String
  variant            ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)

  @@id([variantId, availabilityZoneId])
}

model UpgradePath {
  id            String        @id @default(uuid())
  fromProductId String
  fromProduct   Product       @relation("UpgradeFrom", fields: [fromProductId], references: [id])
  toProductId   String
  toProduct     Product       @relation("UpgradeTo", fields: [toProductId], references: [id])
  fromVersion   String
  toVersion     String
  migrationType MigrationType
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Flavor {
  id            String           @id @default(uuid())
  name          String           @unique
  vcpu          Int
  ramGb         Int
  description   String?
  variants      ProductVariant[]
  forecastLines ForecastLine[]
  instances     Instance[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Dependency {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation("ProductDependents", fields: [productId], references: [id])
  dependsOnId String
  dependsOn   Product        @relation("ProductDependencies", fields: [dependsOnId], references: [id])
  type        DependencyType
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([productId, dependsOnId])
}

model Application {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  continuityLevelId  String
  continuityLevel    ContinuityLevel     @relation(fields: [continuityLevelId], references: [id])
  owner              String
  forecasts          Forecast[]
  instances          Instance[]
  maintenanceWindows MaintenanceWindow[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ContinuityLevel {
  id           String        @id @default(uuid())
  name         String        @unique
  rtoMinutes   Int
  rpoMinutes   Int
  description  String?
  color        String        @default("green")
  applications Application[]
  variants     ProductVariant[]
  createdAt    DateTime      @default(now())
}

model Forecast {
  id              String         @id @default(uuid())
  requestedBy     String
  requesterEmail  String
  targetDate      DateTime?
  status          ApprovalStatus @default(PENDING)
  justification   String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  requestedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lines           ForecastLine[]
  instances       Instance[]
  applicationId   String
  application     Application    @relation(fields: [applicationId], references: [id])
  environment     Environment    @default(DEV)
}

model ForecastLine {
  id         String           @id @default(uuid())
  forecastId String
  forecast   Forecast         @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  flavorId   String
  flavor     Flavor           @relation(fields: [flavorId], references: [id])
  azCode     String
  az         AvailabilityZone @relation(fields: [azCode], references: [code])
  quantity   Int              @default(1)
  metadata   Json?
  resiliency ResiliencyLevel  @default(STANDARD)
}

model AvailabilityZone {
  id            String                           @id @default(uuid())
  code          String                           @unique
  name          String
  city          String
  country       String
  region        String
  latitude      Float
  longitude     Float
  isActive      Boolean                          @default(true)
  variantZones  ProductVariantAvailabilityZone[]
  forecastLines ForecastLine[]
  instances     Instance[]
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ComputeType {
  PHYSICAL
  VIRTUAL
}

enum DependencyType {
  REQUIRED
  RECOMMENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  USER
}

enum Environment {
  PRD
  DEV
  STG
}

enum ResiliencyLevel {
  STANDARD
  HA
  MULTI_AZ
}

enum LifecyclePhase {
  RELEASED
  NORMAL_SUPPORT
  EXTENDED_SUPPORT
  NO_SUPPORT
  EOL
}

enum MigrationType {
  IN_PLACE
  REBUILD
  BLUE_GREEN
  SNAPSHOT
}

enum InstanceStatus {
  PENDING
  PROVISIONING
  RUNNING
  STOPPED
  TERMINATED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AvailabilityType {
  STANDARD
  RECOMMENDED
  RESTRICTED
  ON_DEMAND
}

model Backup {
  id          String       @id @default(uuid())
  instanceId  String
  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      BackupStatus @default(PENDING)
  sizeBytes   Int?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  restoredAt  DateTime?

  @@index([instanceId])
  @@index([status])
}

model Instance {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  forecastId         String?
  forecast           Forecast?         @relation(fields: [forecastId], references: [id], onDelete: SetNull)
  applicationId      String
  application        Application       @relation(fields: [applicationId], references: [id])
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant?   @relation(fields: [variantId], references: [id])
  flavorId           String
  flavor             Flavor            @relation(fields: [flavorId], references: [id])
  azCode             String
  az                 AvailabilityZone  @relation(fields: [azCode], references: [code])
  status             InstanceStatus    @default(PENDING)
  environment        Environment       @default(DEV)
  ipAddress          String?
  hostname           String?
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  startedAt          DateTime?
  stoppedAt          DateTime?
  terminatedAt       DateTime?
  healthChecks       HealthCheck[]
  maintenanceWindows MaintenanceWindow[]
  backups            Backup[]
}

model HealthCheck {
  id             String       @id @default(uuid())
  instanceId     String
  instance       Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  status         HealthStatus @default(HEALTHY)
  cpuPercent     Float        @default(0)
  memoryPercent  Float        @default(0)
  diskPercent    Float        @default(0)
  responseTimeMs Int          @default(0)
  checkedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([instanceId, checkedAt])
}

model MaintenanceWindow {
  id              String            @id @default(uuid())
  instanceId      String?
  instance        Instance?         @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  applicationId   String?
  application     Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          MaintenanceStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([instanceId])
  @@index([applicationId])
  @@index([startTime, endTime])
}
