generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                String                      @id @default(uuid())
  name              String
  slug              String                      @unique
  description       String?
  categoryId        String
  category          Category                    @relation(fields: [categoryId], references: [id])
  flavors           Flavor[]
  dependencies      Dependency[]                @relation("ProductDependencies")
  dependentProducts Dependency[]                @relation("ProductDependents")
  forecasts         Forecast[]
  availabilityZones ProductAvailabilityZone[]
  documentation     String?
  roadmap           String?
  os                String?
  isActive          Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
}

model Flavor {
  id          String    @id @default(uuid())
  name        String
  vcpu        Int
  ramGb       Int
  description String?
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  forecasts   Forecast[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Dependency {
  id          String           @id @default(uuid())
  productId   String
  product     Product          @relation("ProductDependents", fields: [productId], references: [id])
  dependsOnId String
  dependsOn   Product          @relation("ProductDependencies", fields: [dependsOnId], references: [id])
  type        DependencyType
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([productId, dependsOnId])
}

model Forecast {
  id                String                       @id @default(uuid())
  productId         String
  product           Product                      @relation(fields: [productId], references: [id])
  flavorId          String
  flavor            Flavor                       @relation(fields: [flavorId], references: [id])
  requestedBy       String
  requesterEmail    String
  targetDate        DateTime?
  availabilityZones String[]
  status            ApprovalStatus               @default(PENDING)
  justification     String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  requestedAt       DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  azDetails         ForecastAvailabilityZone[]
}

model ForecastAvailabilityZone {
  id         String   @id @default(uuid())
  forecastId String
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  azCode     String
  quantity   Int      @default(1)

  @@unique([forecastId, azCode])
}

model AvailabilityZone {
  id                    String                      @id @default(uuid())
  code                  String                      @unique
  name                  String
  city                  String
  country               String
  region                String
  latitude              Float
  longitude             Float
  isActive              Boolean                     @default(true)
  productAvailabilities ProductAvailabilityZone[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}

model ProductAvailabilityZone {
  id                 String           @id @default(uuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([productId, availabilityZoneId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DependencyType {
  REQUIRED
  RECOMMENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  USER
}
