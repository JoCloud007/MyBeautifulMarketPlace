generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  flavors     Flavor[]
  flavorFieldDefinitions FlavorFieldDefinition[]
  flavorProfiles FlavorProfile[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Profile × Size grid (AWS-style) owned per Category.
// Unrelated to PerformanceProfile (metric model).
// slug is unique per category and must not be renamed after creation.
model FlavorProfile {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  flavors     Flavor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, slug])
}

model FlavorFieldDefinition {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  unit       String?
  type       String   @default("string")
  required   Boolean  @default(false)
  order      Int      @default(0)
  options    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, key])
}

model Product {
  id                  String                    @id @default(uuid())
  name                String
  slug                String                    @unique
  description         String?
  categoryId          String
  category            Category                  @relation(fields: [categoryId], references: [id])
  computeType         ComputeType?
  variants            ProductVariant[]
  dependencies        Dependency[]              @relation("ProductDependencies")
  dependentProducts   Dependency[]              @relation("ProductDependents")
  forecastLines       ForecastLine[]
  upgradeFrom         UpgradePath[]             @relation("UpgradeFrom")
  upgradeTo           UpgradePath[]             @relation("UpgradeTo")
  transitionsFrom     Transition[]              @relation("TransitionsFrom")
  transitionsTo       Transition[]              @relation("TransitionsTo")
  instances           Instance[]
  zones               ProductZone[]
  regions             ProductRegion[]
  availabilityZones   ProductAvailabilityZone[]
  productVersions     ProductVersion[]
  stackComponents     ProductVersionComponent[] @relation("StackComponentProduct")
  rulesAsSource       CompatibilityRule[]       @relation("RuleFromProduct")
  rulesAsTarget       CompatibilityRule[]       @relation("RuleToProduct")
  scopedRules         CompatibilityRule[]       @relation("RuleScopeProduct")
  performanceProfiles PerformanceProfile[]
  resiliencyLevels    ProductResiliency[]
  resiliencyScopes    ResiliencyScope[]
  documentation       String?
  roadmap             String?
  os                  String?
  initialReleaseDate  DateTime?
  productEOLDate      DateTime?
  status              ProductStatus             @default(AVAILABLE)
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model ProductVersion {
  id                 String                           @id @default(uuid())
  productId          String
  product            Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  version            String
  releaseDate        DateTime?
  normalSupportEnd   DateTime?
  extendedSupportEnd DateTime?
  eolDate            DateTime?
  phase              LifecyclePhase                   @default(RELEASED)
  isActive           Boolean                          @default(true)
  changelog          String?
  // Normalised version tuple (spec: Stacks de produits §1.1). The `version`
  // string stays the display source; the tuple powers range comparisons.
  // Nullable: rows with a non-numeric version keep a null tuple.
  versionMajor       Int?
  versionMinor       Int?
  versionPatch       Int?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  regions            ProductVersionRegion[]
  zones              ProductVersionZone[]
  availabilityZones  ProductVersionAvailabilityZone[]
  variants           ProductVariant[]
  stackComponents    ProductVersionComponent[]        @relation("StackContainer")
  componentOf        ProductVersionComponent[]        @relation("StackComponentVersion")

  @@unique([productId, version])
}

model OperatingSystem {
  id               String                @id @default(uuid())
  family           String
  name             String
  slug             String                @unique
  isActive         Boolean               @default(true)
  availabilityType AvailabilityType      @default(STANDARD)
  versions         OsVersion[]
  variants         ProductVariant[]
  zones            OperatingSystemZone[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model OsVersion {
  id                 String           @id @default(uuid())
  osId               String
  os                 OperatingSystem  @relation(fields: [osId], references: [id], onDelete: Cascade)
  version            String
  releaseDate        DateTime
  normalSupportEnd   DateTime
  extendedSupportEnd DateTime
  eolDate            DateTime
  phase              LifecyclePhase   @default(RELEASED)
  isActive           Boolean          @default(true)
  // Per-version availability override; null inherits OperatingSystem.availabilityType.
  availabilityType   AvailabilityType?
  // Normalised version tuple (spec: Stacks de produits §1.1) — nullable,
  // non-numeric versions keep a null tuple.
  versionMajor       Int?
  versionMinor       Int?
  versionPatch       Int?
  variants           ProductVariant[]
  transitionsFrom    Transition[]     @relation("TransitionFromOsVersion")
  transitionsTo      Transition[]     @relation("TransitionToOsVersion")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([osId, version])
}

model ProductVariant {
  id                 String                           @id @default(uuid())
  productId          String
  product            Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  // OS fields are optional: storage products (NAS, Object Storage) have no
  // operating system but must still bind a flavor through their variants.
  osId               String?
  os                 OperatingSystem?                 @relation(fields: [osId], references: [id])
  osVersionId        String?
  osVersion          OsVersion?                       @relation(fields: [osVersionId], references: [id])
  flavorId           String
  flavor             Flavor                           @relation(fields: [flavorId], references: [id])
  availabilityZones  ProductVariantAvailabilityZone[]
  zones              ProductVariantZone[]
  continuityLevelId  String?
  continuityLevel    ContinuityLevel?                 @relation(fields: [continuityLevelId], references: [id])
  productVersionId   String?
  productVersion     ProductVersion?                  @relation(fields: [productVersionId], references: [id])
  instances          Instance[]
  forecastLines      ForecastLine[]
  releaseDate        DateTime?
  normalSupportEnd   DateTime?
  extendedSupportEnd DateTime?
  eolDate            DateTime?
  phase              LifecyclePhase                   @default(RELEASED)
  isActive           Boolean                          @default(true)
  availabilityType   AvailabilityType                 @default(STANDARD)
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@unique([productId, name])
}

model ProductVariantAvailabilityZone {
  variantId          String
  variant            ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)

  @@id([variantId, availabilityZoneId])
}

model Transition {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  fromProductId String
  fromProduct   Product       @relation("TransitionsFrom", fields: [fromProductId], references: [id])
  toProductId   String
  toProduct     Product       @relation("TransitionsTo", fields: [toProductId], references: [id])
  fromVersion   String
  toVersion     String
  // OS-kind transitions reference explicit OsVersion rows; the legacy
  // fromVersion/toVersion strings above are kept in sync (auto-filled from
  // OsVersion.version) for consumers that read the free-text fields.
  kind            TransitionKind @default(PRODUCT)
  fromOsVersionId String?
  fromOsVersion   OsVersion?     @relation("TransitionFromOsVersion", fields: [fromOsVersionId], references: [id])
  toOsVersionId   String?
  toOsVersion     OsVersion?     @relation("TransitionToOsVersion", fields: [toOsVersionId], references: [id])
  migrationType MigrationType @default(REBUILD)
  status        ProductStatus @default(BACKLOG)
  availableFrom DateTime?
  eolDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([fromProductId])
  @@index([toProductId])
}

model UpgradePath {
  id            String        @id @default(uuid())
  fromProductId String
  fromProduct   Product       @relation("UpgradeFrom", fields: [fromProductId], references: [id])
  toProductId   String
  toProduct     Product       @relation("UpgradeTo", fields: [toProductId], references: [id])
  fromVersion   String
  toVersion     String
  migrationType MigrationType
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Flavor {
  id                  String                   @id @default(uuid())
  name                String                   @unique
  categoryId          String?
  category            Category?                @relation(fields: [categoryId], references: [id])
  profileId           String?
  profile             FlavorProfile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  sizeLabel           String?
  sizeRank            Int?
  vcpu                Int?
  ramGb               Int?
  attributes          Json?
  description         String?
  releaseDate         DateTime?
  deprecationDate     DateTime?
  eolDate             DateTime?
  variants            ProductVariant[]
  forecastLines       ForecastLine[]
  instances           Instance[]
  zones               FlavorZone[]
  regions             FlavorRegion[]
  availabilityZones   FlavorAvailabilityZone[]
  performanceProfiles PerformanceProfile[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model Dependency {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation("ProductDependents", fields: [productId], references: [id])
  dependsOnId String
  dependsOn   Product        @relation("ProductDependencies", fields: [dependsOnId], references: [id])
  type        DependencyType
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([productId, dependsOnId])
}

model Application {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  snowSysId          String?             @unique
  source             String              @default("MANUAL")
  continuityLevelId  String
  continuityLevel    ContinuityLevel     @relation(fields: [continuityLevelId], references: [id])
  owner              String
  forecasts          Forecast[]
  instances          Instance[]
  maintenanceWindows MaintenanceWindow[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ContinuityLevel {
  id           String           @id @default(uuid())
  name         String           @unique
  rtoMinutes   Int
  rpoMinutes   Int
  description  String?
  color        String           @default("green")
  applications Application[]
  variants     ProductVariant[]
  createdAt    DateTime         @default(now())
}

model Forecast {
  id              String         @id @default(uuid())
  requestedBy     String
  requesterEmail  String
  targetDate      DateTime?
  status          ForecastStatus @default(DRAFT)
  justification   String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  estimatedCost   Float?
  costCurrency    String         @default("EUR")
  submittedAt     DateTime?
  requestedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lines           ForecastLine[]
  transitions     ForecastTransition[]
  instances       Instance[]
  applicationId   String?
  application     Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  environment     Environment    @default(DEV)

  @@index([status])
  @@index([requestedBy])
}

model ForecastLine {
  id         String           @id @default(uuid())
  forecastId String
  forecast   Forecast         @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  flavorId   String?
  flavor     Flavor?          @relation(fields: [flavorId], references: [id])
  azCode     String
  az         AvailabilityZone @relation(fields: [azCode], references: [code])
  quantity   Int              @default(1)
  metadata   Json?
  resiliency String           @default("STANDARD")
  unitPrice  Float?
}

model ServiceNowConfig {
  id             String    @id @default("singleton")
  instanceUrl    String?
  username       String?
  password       String?
  snowTable      String    @default("cmdb_ci_appl")
  enabled        Boolean   @default(false)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ForecastTransition {
  id         String         @id @default(uuid())
  forecastId String
  forecast   Forecast       @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  action     ForecastAction
  fromStatus ForecastStatus
  toStatus   ForecastStatus
  actorName  String
  actorEmail String?
  actorRole  Role?
  comment    String?
  createdAt  DateTime @default(now())

  @@index([forecastId])
  @@index([createdAt])
}

model InfraVersion {
  id                 String                 @id @default(uuid())
  code               String                 @unique
  name               String
  description        String?
  releaseDate        DateTime?
  normalSupportEnd   DateTime?
  extendedSupportEnd DateTime?
  eolDate            DateTime?
  phase              LifecyclePhase         @default(RELEASED)
  isActive           Boolean                @default(true)
  changelog          String?
  availabilityZones  AzInfraVersion[]
  availabilitySchedules AvailabilitySchedule[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model AzInfraVersion {
  availabilityZoneId String           @map("availabilityZoneId")
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)
  infraVersionId     String
  infraVersion       InfraVersion     @relation(fields: [infraVersionId], references: [id], onDelete: Cascade)

  @@id([availabilityZoneId, infraVersionId])
}

model Country {
  id        String   @id @default(uuid())
  code      String   @unique // ISO 3166-1 alpha-2
  name      String   @unique
  flagEmoji String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id                    String                 @id @default(uuid())
  name                  String                 @unique
  slug                  String                 @unique
  description           String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  productRegions        ProductRegion[]
  productVersionRegions ProductVersionRegion[]
  flavorRegions         FlavorRegion[]
  availabilitySchedules AvailabilitySchedule[]
}

model AvailabilityZone {
  id                       String                           @id @default(uuid())
  code                     String                           @unique
  name                     String
  city                     String
  country                  String
  region                   String
  latitude                 Float?
  longitude                Float?
  isActive                 Boolean                          @default(true)
  variantZones             ProductVariantAvailabilityZone[]
  zones                    ZoneAvailabilityZone[]
  forecastLines            ForecastLine[]
  instances                Instance[]
  productVersions          ProductVersionAvailabilityZone[]
  productAvailabilityZones ProductAvailabilityZone[]
  flavorAvailabilityZones  FlavorAvailabilityZone[]
  availabilitySchedules    AvailabilitySchedule[]
  infraVersions            AzInfraVersion[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
}

model Zone {
  id                    String                 @id @default(uuid())
  name                  String                 @unique
  slug                  String                 @unique
  description           String?
  isActive              Boolean                @default(true)
  availabilityZones     ZoneAvailabilityZone[]
  variants              ProductVariantZone[]
  products              ProductZone[]
  flavors               FlavorZone[]
  operatingSystems      OperatingSystemZone[]
  productVersions       ProductVersionZone[]
  availabilitySchedules AvailabilitySchedule[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model ZoneAvailabilityZone {
  zoneId             String
  zone               Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)

  @@id([zoneId, availabilityZoneId])
}

model ProductVariantZone {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  zoneId    String
  zone      Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([variantId, zoneId])
}

model ProductZone {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  zoneId    String
  zone      Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([productId, zoneId])
}

model FlavorZone {
  flavorId String
  flavor   Flavor @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([flavorId, zoneId])
}

model OperatingSystemZone {
  operatingSystemId String
  operatingSystem   OperatingSystem @relation(fields: [operatingSystemId], references: [id], onDelete: Cascade)
  zoneId            String
  zone              Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([operatingSystemId, zoneId])
}

model ProductVersionZone {
  productVersionId String
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([productVersionId, zoneId])
}

model ProductVersionAvailabilityZone {
  productVersionId   String
  productVersion     ProductVersion   @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)

  @@id([productVersionId, availabilityZoneId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(USER)
  roles     Role[]   @default([])
  managerId String?
  manager   User?    @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]   @relation("UserManager")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PresentationOrder {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true)
  isDefault   Boolean            @default(false)
  steps       PresentationStep[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PresentationStep {
  id         String               @id @default(uuid())
  orderId    String
  order      PresentationOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepType   PresentationStepType
  position   Int
  label      String?
  filterRule String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([orderId, position])
}

model PerformanceProfile {
  id           String                @id @default(uuid())
  name         String
  targetType   PerformanceTargetType
  targetId     String
  overallScore Int
  scoreLabel   String?
  colorTheme   String                @default("blue")
  visibility   VisibilityType        @default(SHOW_ALL)
  metrics      PerformanceMetric[]
  product      Product?              @relation(fields: [productId], references: [id])
  productId    String?
  flavor       Flavor?               @relation(fields: [flavorId], references: [id])
  flavorId     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([targetType, targetId, name])
}

model PerformanceMetric {
  id           String             @id @default(uuid())
  profileId    String
  profile      PerformanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  value        Float
  unit         String?
  comparison   String?
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum PresentationStepType {
  COUNTRY
  ZONE
  PRODUCT
  FLAVOR
  USE_CASE
  CATEGORY
  CONTINUITY
  OS
}

enum PerformanceTargetType {
  PRODUCT
  FLAVOR
}

enum VisibilityType {
  SHOW_ALL
  INTERNAL_ONLY
  HIDDEN
}

enum ComputeType {
  PHYSICAL
  VIRTUAL
}

enum DependencyType {
  REQUIRED
  RECOMMENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  USER
}

enum ForecastStatus {
  DRAFT
  PENDING_TECH
  PENDING_MANAGER
  PENDING_BUDGET
  APPROVED
  REJECTED
  CANCELLED
}

enum ForecastAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  CANCEL
  RESUBMIT
}

enum Role {
  ADMIN
  REQUESTER
  TECH_LEAD
  MANAGER
  FINANCE
}

enum Environment {
  PRD
  DEV
  STG
}

enum ResiliencyLevel {
  STANDARD
  HA
  MULTI_AZ
}

/// Admin-configurable resiliency levels (replaces the hardcoded enum for new data).
/// `rank` orders levels for compliance ("max resiliency"); `minAz` is the number
/// of distinct availability zones a forecast line at this level requires.
model ResiliencyLevelConfig {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  rank         Int
  minAz        Int      @default(1)
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productLevels ProductResiliency[]
  scopes        ResiliencyScope[]
}

/// Which resiliency levels are available for which product.
/// If a product has no entry, ALL active levels are allowed (backward compatible).
model ProductResiliency {
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  levelCode String
  level     ResiliencyLevelConfig @relation(fields: [levelCode], references: [code], onDelete: Cascade)

  @@id([productId, levelCode])
}

/// Fine-grained resiliency availability rules, scoped by region / availability
/// zone / zone / flavor. Precedence (most specific wins):
/// FLAVOR > AVAILABILITY_ZONE > ZONE > REGION > ProductResiliency > all-active default.
/// A rule with a null productId is a catalog-wide rule. `allowed=false` denies.
model ResiliencyScope {
  id        String                @id @default(uuid())
  levelCode String
  level     ResiliencyLevelConfig @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  productId String?
  product   Product?              @relation(fields: [productId], references: [id], onDelete: Cascade)
  scopeType String
  scopeId   String
  allowed   Boolean

  @@unique([levelCode, productId, scopeType, scopeId])
  @@index([productId])
  @@index([scopeType, scopeId])
}

enum ProductStatus {
  BACKLOG
  OPPORTUNITY
  AVAILABLE
  AVAILABLE_PILOT_PENDING
  DELAY_PENDING
  CANCELLED
}

enum LifecyclePhase {
  RELEASED
  NORMAL_SUPPORT
  EXTENDED_SUPPORT
  NO_SUPPORT
  EOL
}

enum MigrationType {
  IN_PLACE
  REBUILD
  BLUE_GREEN
  SNAPSHOT
}

enum TransitionKind {
  PRODUCT
  OS
}

enum InstanceStatus {
  PENDING
  PROVISIONING
  RUNNING
  STOPPED
  TERMINATED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AvailabilityType {
  STANDARD
  RECOMMENDED
  RESTRICTED
  ON_DEMAND
}

enum AvailabilityTargetType {
  PRODUCT
  PRODUCT_VERSION
  FLAVOR
  INFRA_VERSION
}

model ProductRegion {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  regionId  String
  region    Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([productId, regionId])
}

model ProductVersionRegion {
  productVersionId String
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  regionId         String
  region           Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([productVersionId, regionId])
}

model FlavorRegion {
  flavorId String
  flavor   Flavor @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([flavorId, regionId])
}

model ProductAvailabilityZone {
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)

  @@id([productId, availabilityZoneId])
}

model FlavorAvailabilityZone {
  flavorId           String
  flavor             Flavor           @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  availabilityZoneId String
  availabilityZone   AvailabilityZone @relation(fields: [availabilityZoneId], references: [id], onDelete: Cascade)

  @@id([flavorId, availabilityZoneId])
}

model AvailabilitySchedule {
  id             String                 @id @default(uuid())
  targetType     AvailabilityTargetType
  targetId       String
  regionId       String?
  region         Region?                @relation(fields: [regionId], references: [id], onDelete: SetNull)
  azId           String?
  az             AvailabilityZone?      @relation(fields: [azId], references: [id], onDelete: SetNull)
  zoneId         String?
  zone           Zone?                  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  infraVersionId String?
  infraVersion   InfraVersion?          @relation(fields: [infraVersionId], references: [id], onDelete: SetNull)
  availableFrom  DateTime?
  availableUntil DateTime?
  status         AvailabilityType       @default(STANDARD)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([targetType, targetId])
}

model Backup {
  id          String       @id @default(uuid())
  instanceId  String
  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      BackupStatus @default(PENDING)
  sizeBytes   Int?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  restoredAt  DateTime?

  @@index([instanceId])
  @@index([status])
}

model Instance {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  forecastId         String?
  forecast           Forecast?           @relation(fields: [forecastId], references: [id], onDelete: SetNull)
  applicationId      String
  application        Application         @relation(fields: [applicationId], references: [id])
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])
  flavorId           String
  flavor             Flavor              @relation(fields: [flavorId], references: [id])
  azCode             String
  az                 AvailabilityZone    @relation(fields: [azCode], references: [code])
  status             InstanceStatus      @default(PENDING)
  environment        Environment         @default(DEV)
  ipAddress          String?
  hostname           String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  startedAt          DateTime?
  stoppedAt          DateTime?
  terminatedAt       DateTime?
  healthChecks       HealthCheck[]
  maintenanceWindows MaintenanceWindow[]
  backups            Backup[]
}

model HealthCheck {
  id             String       @id @default(uuid())
  instanceId     String
  instance       Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  status         HealthStatus @default(HEALTHY)
  cpuPercent     Float        @default(0)
  memoryPercent  Float        @default(0)
  diskPercent    Float        @default(0)
  responseTimeMs Int          @default(0)
  checkedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([instanceId, checkedAt])
}

model MaintenanceWindow {
  id            String            @id @default(uuid())
  instanceId    String?
  instance      Instance?         @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  status        MaintenanceStatus @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([instanceId])
  @@index([applicationId])
  @@index([startTime, endTime])
}

// §1.2 Stack components — a product version is its own stack, carrying a list
// of pinned components (product + version). A version without components is an
// atomic product (e.g. a VM). Additive model; the version/product coherence of
// (componentProductId, componentVersionId) is enforced by API validation.
model ProductVersionComponent {
  id                 String         @id @default(uuid())
  containerVersionId String
  containerVersion   ProductVersion @relation("StackContainer", fields: [containerVersionId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product        @relation("StackComponentProduct", fields: [componentProductId], references: [id], onDelete: Cascade)
  componentVersionId String
  componentVersion   ProductVersion @relation("StackComponentVersion", fields: [componentVersionId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())

  @@unique([containerVersionId, componentProductId])
}

// §1.3 Compatibility rules — declared between product versions as operator
// ranges (constraint grammar §2 of the spec). Never stored results: the matrix
// and the live composer compute verdicts from these rules.
model CompatibilityRule {
  id                    String        @id @default(uuid())
  name                  String
  description           String?
  fromProductId         String
  fromProduct           Product       @relation("RuleFromProduct", fields: [fromProductId], references: [id], onDelete: Cascade)
  fromVersionConstraint String?
  toProductId           String
  toProduct             Product       @relation("RuleToProduct", fields: [toProductId], references: [id], onDelete: Cascade)
  toVersionConstraint   String?
  kind                  RuleKind
  severity              RuleSeverity
  scopeType             RuleScope
  scopeProductId        String?
  scopeProduct          Product?      @relation("RuleScopeProduct", fields: [scopeProductId], references: [id], onDelete: Cascade)
  justification         String?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([fromProductId])
  @@index([toProductId])
  @@index([scopeProductId])
}

enum RuleKind {
  REQUIRES
  FORBIDS
}

enum RuleSeverity {
  HARD
  SOFT
}

enum RuleScope {
  GLOBAL
  PRODUCT
}
